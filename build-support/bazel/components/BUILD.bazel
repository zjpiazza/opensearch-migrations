load("@rules_python//python:defs.bzl", "py_test")
load("@console_pypi//:requirements.bzl", "requirement")

py_test(
    name = "workflow_output_integration_test",
    srcs = ["test_workflow_output_integration.py", "//build-support/bazel:pytest_main.py"],
    main = "//build-support/bazel:pytest_main.py",
    args = ["$(location test_workflow_output_integration.py)"],
    deps = [
        "//migrationConsole/lib/console_link:workflow_outputs",
        "//migrationConsole/lib/integ_test:approval_contract",
