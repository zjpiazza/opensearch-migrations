    name = "http_contract",
    srcs = [
        "src/main/java/org/opensearch/migrations/bulkload/common/ObjectMapperFactory.java",
        "src/main/java/org/opensearch/migrations/bulkload/common/RfsException.java",
        "src/main/java/org/opensearch/migrations/bulkload/tracing/IRfsContexts.java",
    ],
    plugins = ["//tools/build/bazel:lombok"],
    deps = [
        "//libs/runtime:lib",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:org_projectlombok_lombok",
        "@maven//:org_slf4j_slf4j_api",
        "@maven//:io_opentelemetry_opentelemetry_api",
        "@maven//:io_opentelemetry_opentelemetry_context",
    ],
    visibility = ["//visibility:public"],
