        "src/main/java/org/opensearch/migrations/bulkload/pipeline/model/Document.java",
        "src/main/java/org/opensearch/migrations/bulkload/pipeline/model/Partition.java",
        "src/main/java/org/opensearch/migrations/bulkload/pipeline/model/ProgressCursor.java",
        "src/main/java/org/opensearch/migrations/bulkload/pipeline/sink/DocumentSink.java",
    ],
    plugins = ["//tools/build/bazel:lombok"],
    deps = [
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:org_projectlombok_lombok",
