# Experimental test slice; Gradle remains the production build.
common --enable_bzlmod
build --java_language_version=21
build --tool_java_language_version=21
build --java_runtime_version=remotejdk_21
build --tool_java_runtime_version=remotejdk_21
build --jobs=4
# Lombok changes javac ASTs and cannot run under Turbine header compilation.
build --nojava_header_compilation
test --test_output=errors
test --test_env=TZ=UTC
test --test_env=LANG=C.UTF-8

# Opt-in only. Reach the ClusterIP via an authenticated localhost port-forward.
build:buildbarn --remote_executor=grpc://127.0.0.1:8980
build:buildbarn --remote_cache=grpc://127.0.0.1:8980
build:buildbarn --remote_instance_name=migrations-pilot
build:buildbarn --extra_execution_platforms=//tools/build/bazel:buildbarn_linux
build:buildbarn --jobs=18
build:buildbarn --remote_download_outputs=toplevel
build:buildbarn --incompatible_strict_action_env
build:buildbarn --noremote_local_fallback
build:buildbarn --spawn_strategy=remote
build:buildbarn --strategy=Javac=remote
build:buildbarn --remote_timeout=300
