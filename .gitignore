.coverage
/bazel-*
coverage.xml
.idea
.kiro
.DS_Store
.gradle/
.venv
__pycache__
*.egg-info*
.python-version
logs
tmp/
*.tsbuildinfo
*.hprof

test_report.json

**/build/
**/builds/
jenkinsdocker/**/nextBuildNumber
**/bin/
# The migration-assistant CLI ships a source-checkout entry wrapper at
# apps/cli/bin/migration-assistant. It is SOURCE (not a build
# artifact) and every caller — Jenkins, install.sh, awsRunEksValidation.sh —
# invokes that exact path, so it must stay tracked despite the **/bin/ rule.
!apps/cli/bin/
!apps/cli/bin/migration-assistant
# Rust build output for the CLI crate.
apps/cli/target/
# Per-project runtime state the CLI writes at $PWD/migration-assistant-workspace
# (see cli/src/core/config.rs). Never a build/PR artifact.
migration-assistant-workspace/

# The whole plugins directory needs to be removed
plugins/opensearch/loggable-transport-netty4/.gradle/
# Build files
libs/traffic/**/out/
apps/**/out/

# CDK files from end-to-end testing
opensearch-cluster-cdk/
tests/e2e/opensearch-cluster-cdk/
tests/e2e/amazon-opensearch-service-sample-cdk/
deploy/local/docker-compose/src/main/docker/migrationConsole/staging

# Directory used to temporarily store snapshots during testing
apps/backfill/docker/snapshots/
libs/transforms/standardJavascriptTransforms/coverage/
libs/transforms/standardJavascriptTransforms/node_modules/
apps/schema-viewer/node_modules/
apps/schema-viewer/package-lock.json
apps/schema-viewer/schemas/
apps/orchestration/k8sResources/
apps/orchestration/dist/
apps/orchestration/node_modules/
apps/orchestration/packages/**/dist/
apps/orchestration/packages/**/node_modules/
apps/orchestration/packages/**/coverage/
apps/orchestration/packages/migration-workflow-templates/k8sResources
apps/orchestration/k8s-schemas
apps/orchestration/packages/argo-workflow-builders/src/generated
apps/orchestration/packages/config-processor/bundled
apps/orchestration/packages/migration-workflow-templates/workflowTemplates
apps/orchestration/packages/argo-workflow-builders/k8sSchemas
frontend/

# IDE / Java tooling
.settings/
.factorypath
deploy/aws/dist/
apps/cli/dist/
.scannerwork/
.sisyphus/

# Argo workflow files
*.wf.yaml

# Agent related files
.claude/

# Terraform
# Local .terraform directories
.terraform/

# Terrafrom state files
*.tfstate
*.tfstate.*
*.terraform.lock.hcl

# Terraform variable files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Build tooling is source; only nested build outputs are generated.
!tools/build/
!tools/build/**
tools/build/**/build/
tools/build/**/__pycache__/
tools/build/**/*.pyc

# Bazel convenience symlinks and local execution output.
/bazel-*
